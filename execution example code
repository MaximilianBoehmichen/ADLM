import torch
from typing import List, Tuple
import medmnist

class MyDataset(torch.utils.data.Dataset):
    def __init__(self, path_list: List[str], labels: List[int]):
        self.path_list = path_list  # [gauss_repr0.pt, gauss_repr_1.pt]
        self.labels = labels

    def __len__(self):
        return len(self.path_list)

    def __getitem__(self, idx):
        path = self.path_list[idx]
        representation = torch.load(path)
        mus = representation['mus']
        widths = representation['scalings_inv_']
        rots = representation['rotations']
        color = representation['colors'].unsqueeze(1)
        features = torch.cat((widths, rots, color), dim=-1)
        label = torch.tensor(self.labels[idx], dtype=torch.float32)
        knn = representation['knn']
        return mus, features, knn, label


